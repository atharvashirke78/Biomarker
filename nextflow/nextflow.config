// Biomarker RNA-seq pipeline, diagnostic branch. Paths/switches here; ALL thresholds in ../conf/thresholds.config (included below).
// Origin: structure adapted from /workspace/biomarker/pipeline/nextflow.config (see docs/code_sources.md).
// ======================================================================================================================
// USER SETTINGS  -  the ONLY lines a user edits. Everything below this block is fixed and must not be changed for a normal run.
// Both values can also be given on the command line (--input_dir ... --output_dir ...); the command line wins over this file.
// ======================================================================================================================
params {
    input_dir  = null                // <-- EDIT: folder with the paired FASTQ files and metadata.csv (e.g. '/data/my_run'). null = the run stops at the start unless --input_dir is given.
    output_dir = null  // <-- EDIT: folder for all results (a new run needs a folder that has no 00_input yet). null = <input_dir>/Result
}
// ======================================================================================================================
// FIXED SETTINGS (install, thresholds, tools). Do not edit for a normal run.
// ======================================================================================================================
params {
    // ---- one-workflow entry (-entry RUN): resolved from the two user settings above
    output_dir      = params.output_dir ?: (params.input_dir ? "${params.input_dir}/Result" : null)   // not a second setting: keeps the value above (or --output_dir) and only fills the <input_dir>/Result default when it is null; the work folder goes inside it
    stop_after      = null                // -entry RUN: quant | analysis | discover (default: run everything of the chosen mode, then the report)
    stub_fail_sample = null               // test hook, only used with -stub-run: this sample id gets QC status FAIL (tests the exclusion path)
    pod_cpus        = null                // CPUs to use (null = what the container sees)
    pod_mem_gb      = null                // GB of RAM the executor may schedule (null = cgroup limit minus 6 GB; 58 if unreadable)
    check_only      = false               // true: print the startup checks (software, reference, memory, disk, input) and stop
    legacy_default  = false               // true: allow the old no-entry default run (FASTQ sheet -> QUANT -> ANALYSIS) when input_dir is empty (regression test only)
    mode            = 'discover'          // -entry RUN: discover | apply (locked-model scoring)
    cohort          = null                // -entry RUN --mode apply: development | validation (label written into every score output)
    discover_dir    = params.input_dir ? '/09_discover' : ''   // -entry RUN: the discover stage folders (00_input, 01_de, 02_candidates, 03_model) go under <outdir>/09_discover; '' = old layout
    // ---- install locations (resolved, not per-run). code_dir = this checkout; install_dir = where the untracked ref/ and env/ live.
    code_dir        = "${projectDir.parent}"
    install_dir     = System.getenv('BIOMARKER_INSTALL_DIR') ?: "/workspace/Biomarker_pipeline"
    base_dir        = params.code_dir     // legacy root (data/ for the old samplesheet layout); callers may still override it (run_validation.sh)
    samplesheet     = "${params.base_dir}/samplesheets/diagnostic_20.csv"   // sample,run,study,group
    outdir          = params.output_dir ?: "${params.base_dir}/results"
    ref_dir         = "${params.install_dir}/ref"
    genome_source   = "/workspace/genome/hg38/genome/Homo_sapiens_assembly38.fasta"   // read-only source for the filtered primary-chromosome FASTA
    par1_start      = 10001               // GRCh38 chrY PAR1 / PAR2 (genes entirely inside are dropped from the gene set; chrX copies carry the counts)
    par1_end        = 2781479
    par2_start      = 56887903
    par2_end        = 57217415
    gencode_release = 'v50'               // GENCODE human release (latest at build time 2026-10-08); GTF + transcript FASTA
    subsample_pairs = 0                   // >0: use only the first N read pairs per sample (mini test / quick run)
    subsample_dir   = "${params.base_dir}/data/subsampled"
    wait_hours      = 48                  // how long a sample waits for its own FASTQs
    run_star        = true                // STAR route; below min_mem_star_gb main.nf STOPS with an error unless allow_salmon_only = true
    run_fastqc      = false               // fastp already gives raw+trimmed QC
    test_mode       = false               // true ONLY for the 4-sample mini test (relaxes the DESeq2 pre-filter)

    // STAR index build (resource, not a threshold)
    star_index_ram    = 48000000000       // --limitGenomeGenerateRAM (bytes) for the one-time index build

    // ---- refactor (Step 2): stages and switches (design docs/two_pipeline_design.md)
    allow_salmon_only = false             // memory guard: below min_mem_star_gb (or limit unreadable) QUANT stops with an error unless this is true
    legacy_samplesheet = true             // accept the old 4-column sheet (sample,run,study,group): batch = study, baseline = group 'normal'  (owner decision pending, design item 6)
    analysis          = 'diagnostic'      // reserved selector for later branches (prognostic/predictive); only 'diagnostic' exists
    manifest_fastq_md5 = true             // QUANT manifest: md5 of every FASTQ (slow on network disk); false = size only
    // -entry ANALYSIS inputs (all paths; counts_matrix + sample_sheet are required)
    counts_matrix     = null              // contract counts_matrix.tsv (genes x samples; integers when count_source = featurecounts)
    sample_sheet      = null              // contract sample_sheet.tsv (sample_id,label,group,baseline,study,batch,count_source)
    count_source      = 'featurecounts'   // featurecounts | salmon_tximport (route analysed in -entry ANALYSIS)
    counts_rds        = null              // tximport object, needed for count_source = salmon_tximport
    qc_table          = null              // optional contract qc_table.tsv (FAIL samples must not be in the matrix)
    quant_manifest    = null              // optional manifest_quant.json, embedded in manifest_analysis.json
    symbols           = null              // gene_id_to_symbol.tsv (default: ref_dir/gene_id_to_symbol.tsv)

    // ---- Phase 1 (2026-10-15): KEGG switch and -entry DISCOVER (question-driven discovery; docs: results_rc1prep_19/pipeline_plan_20261015/PLAN.md)
    run_kegg          = false             // KEGG ORA/GSEA off by default: KEGG licence for commercial use is unresolved. true = previous behaviour.
    question          = params.input_dir ? 'diagnostic' : null   // -entry DISCOVER: diagnostic (implemented) | prognostic | predictive (not implemented yet; the run stops)
    clinical          = null              // -entry DISCOVER: clinical file (TSV; sample_id, patient_id, group, baseline [, batch, study, label])
    holdout           = null              // -entry DISCOVER: optional file, one sample_id per line (patient-level: a patient may not be in both sets)
    counts_matrix_secondary = null        // -entry DISCOVER: optional second quantification route (Salmon/tximport counts TSV) -> enables rule 3a
    counts_rds_secondary    = null        // -entry DISCOVER: the tximport .rds that matches counts_matrix_secondary (DESeq2 Salmon route)
    patient_level_cv  = false             // -entry DISCOVER: true = leave-one-PATIENT-out when a patient_id is repeated; false (default) = the locked sample-level leave-one-out (19 refits, loo_min_pass 18)
    // ---- upgrade H3 (additive, report-only): internal validation of the finished model, published to <outdir>/09_discover/04_validation. Never changes the model.
    run_internal_validation = true        // false = the step is not started and the workflow behaves exactly as before
    iv_repeats        = 20                // repeated nested CV: number of repeats of the outer 5-fold split
    iv_bootstrap      = 200               // Harrell bootstrap: number of resamples (whole recipe repeated in each)
    iv_subsamples     = 100               // stability selection: number of 80 % subsamples (per-gene selection frequencies, report only)
    questions_config  ="${params.code_dir}/config/questions.yaml"   // per-question settings, incl. PROVISIONAL values and the robustness rule
}

// Every threshold (fastp, STAR/featureCounts, QC, cohort QC, DESeq2, pathways, ANALYSIS checks) is in ONE file:
includeConfig '../conf/thresholds.config'
includeConfig '../conf/input.config'

conda {
    enabled        = params.input_dir ? true : false   // -entry RUN (--input_dir given): on by default; the other entries need -profile conda
    useMicromamba  = true
    channels       = ['conda-forge', 'bioconda']
    cacheDir       = "${params.install_dir}/env/nf_conda"
}

// Nextflow creates the work folder at launch, before any check: so it is only placed inside the output folder when the input folder exists
// (a mistyped input_dir must not leave a new folder behind); otherwise a throw-away folder in the system temp folder is used and the run stops at the startup checks
workDir = (params.input_dir && !new File(params.input_dir.toString()).isDirectory()) ? "${System.getProperty('java.io.tmpdir')}/biomarker_no_input_work" :
          (params.output_dir ? "${params.output_dir}/work" : "${params.base_dir}/work")

// -entry RUN: Nextflow's own run records go into <output_dir>/logs (disabled for the other entries, which pass -with-trace / -with-report themselves)
def inputFolderExists = params.input_dir && new File(params.input_dir.toString()).isDirectory()   // log files are only set up for an existing input folder (no folder is created at a mistyped path)
def launchStamp = new Date().format('yyyyMMdd_HHmmss')          // one set of log files per launch: a resume never overwrites (or collides with) an earlier attempt's trace
trace    { enabled = (params.output_dir && inputFolderExists) as boolean; file = "${params.output_dir ?: '.'}/logs/trace_${launchStamp}.tsv"; fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rss,vmem,workdir' }
report   { enabled = (params.output_dir && inputFolderExists) as boolean; file = "${params.output_dir ?: '.'}/logs/nextflow_report_${launchStamp}.html" }
timeline { enabled = (params.output_dir && inputFolderExists) as boolean; file = "${params.output_dir ?: '.'}/logs/timeline_${launchStamp}.html" }

// Measured: nproc 16, cgroup memory limit 64 GB (2026-10-08). Executor budget keeps headroom for the OS.
// Resource budget follows the pod (RunPod: pick any CPU/RAM size). CPUs = what the container sees; memory = cgroup limit (decimal GB) minus 6 GB for the OS.
// Fallback when the cgroup limit is unreadable: 16 CPUs / 58 GB (the measured 64 GB pod: identical values, so the validated run is unchanged).
// Override: --pod_cpus N --pod_mem_gb N.
def podCpus = (params.pod_cpus ?: Runtime.runtime.availableProcessors()) as int
def podMemGb = params.pod_mem_gb ? (params.pod_mem_gb as int) : null
if (!podMemGb) {
    for (cg in ['/sys/fs/cgroup/memory.max', '/sys/fs/cgroup/memory/memory.limit_in_bytes']) {
        def f = new File(cg)
        if (!podMemGb && f.exists()) { def t = f.text.trim(); if (t.isLong() && t.toLong() < (1L << 50)) podMemGb = (t.toLong() / 1000000000L) as int - 6 }
    }
}
podMemGb = podMemGb ?: 58
def memCapGb = Math.max(podMemGb - 2, 4)     // largest single request: a retry must always fit the budget
executor { name = 'local'; cpus = podCpus; memory = "${podMemGb} GB"; queueSize = podCpus }

process {
    // Retry ONLY for out-of-memory / killed / abort / segfault / time-limit style exit codes (137 SIGKILL, 143 SIGTERM, 134 SIGABRT,
    // 139 SIGSEGV, 104 connection reset); every other error: let running tasks finish, then stop (no retry).
    errorStrategy = { task.exitStatus in [137, 143, 134, 139, 104] ? 'retry' : 'finish' }
    maxRetries    = 2
    cache         = 'lenient'          // cache on path + size + name, not mtime (this FUSE disk changes mtimes)
    // Every memory request is capped at 56 GB (executor budget is 58 GB), so a retry can always be scheduled.
    withLabel: process_low            { cpus = 1;  memory = { [ 4.GB  * task.attempt, memCapGb.GB ].min() }; time = { 2.h  * task.attempt } }
    withLabel: process_medium         { cpus = 4;  memory = { [ 8.GB  * task.attempt, memCapGb.GB ].min() }; time = { 6.h  * task.attempt } }
    withLabel: process_high           { cpus = 8;  memory = { [ 32.GB * task.attempt, memCapGb.GB ].min() }; time = { 12.h * task.attempt } }
    withLabel: process_fastp          { cpus = 4;  memory = { [ 8.GB  * task.attempt, memCapGb.GB ].min() }; time = { 6.h  * task.attempt } }
    // 2026-10-09: Salmon 28 GB fixed (no attempt scaling), cpus 8, maxForks 2 (2 x 28 = 56 GB fits the 58 GB executor budget; measured peaks 25.9 / 26.6 GB). Earlier: 30 GB x attempt, cpus 6, no maxForks.
    // Salmon quant: measured peak_rss 25.9 GB (mini test, 4 samples, decoy-aware index, --gcBias --seqBias); declared 30 GB (was 16 GB: too low, would let several jobs overcommit the 64 GB cgroup)
    withLabel: process_salmon         { cpus = Math.min(8, podCpus);  memory = 28.GB; time = { 12.h * task.attempt }; maxForks = Math.max(1, (int)(podMemGb / 28)) }
    withLabel: process_samtools       { cpus = 4;  memory = { [ 12.GB * task.attempt, memCapGb.GB ].min() }; time = { 6.h  * task.attempt } }
    withLabel: process_featurecounts  { cpus = 4;  memory = { [ 8.GB  * task.attempt, memCapGb.GB ].min() }; time = { 6.h  * task.attempt } }
    withLabel: process_star_index     { cpus = 12; memory = { [ 52.GB * task.attempt, memCapGb.GB ].min() }; time = { 24.h } }
    // STAR_ALIGN (measured in the mini test, trace logs/mini_trace_run1.tsv): peak_rss 28.5 GB, peak_vmem 29.2 GB per job (genome index in RAM).
    // Two jobs = 57 GB > what is left of the 58 GB executor budget once fastp/samtools/featureCounts/Salmon run, so maxForks = 1 (formula floor(64/32)=2 was only an upper bound).
    // Memory request = 28.5 GB + ~15% = 33 GB.
    withLabel: process_star           { cpus = Math.min(8, podCpus);  memory = { [ 33.GB * task.attempt, memCapGb.GB ].min() }; time = { 12.h * task.attempt }; maxForks = Math.max(1, (int)(podMemGb / 33)) }
}

profiles {
    conda { conda.enabled = true }
    // -stub-run test: own work/out/ref dirs, nothing real is built or published into results/
    stubtest {
        params.outdir  = "${params.base_dir}/results_stub"
        params.ref_dir = "${params.base_dir}/work_stub/ref"
        workDir        = "${params.base_dir}/work_stub/work"
    }
    // 4-sample mini test: 100000 pairs per sample, separate work/out dirs, relaxed DESeq2 pre-filter (test only)
    test {
        params.samplesheet     = "${params.base_dir}/test_data/test_samplesheet.csv"
        params.subsample_pairs = 100000
        params.subsample_dir   = "${params.base_dir}/test_data"
        params.outdir          = "${params.base_dir}/results_test"
        params.test_mode       = true
        params.de_min_count    = 2
        params.de_min_samples  = 2
        workDir                = "${params.base_dir}/work_test"
    }
}

manifest {
    name            = 'biomarker-rnaseq-diagnostic'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
}
