// Central thresholds file (refactor Step 3). EVERY cutoff of the pipeline lives here; no number is hard-coded in a script or module.
// Included from nextflow/nextflow.config. Values are the ones used before the refactor unless marked CHANGED / PROVISIONAL.
// The resolved values of this run are written to contract/manifest_*.json ("parameters"). Profiles (test) may override single values.
params {
    // ---- fastp (per sample), bin/ -> modules/fastp.nf
    fastp_qual        = 20                // -q: base counted as qualified if Phred >= this
    fastp_unqual_pct  = 40                // --unqualified_percent_limit: max % of unqualified bases per read
    fastp_cut_window  = 4                 // --cut_window_size for --cut_tail
    fastp_cut_mean_q  = 20                // --cut_mean_quality for --cut_tail
    fastp_min_len     = 36                // --length_required: drop reads shorter than this
    fastp_n_base      = 5                 // --n_base_limit: drop reads with more N bases than this

    // ---- STAR / featureCounts
    star_multimap_max = 20                // --outFilterMultimapNmax
    fc_min_mapq       = 10                // featureCounts -Q
    min_mem_star_gb   = 32                // memory guard: STAR route needs a cgroup memory limit >= this (was hard-coded in main.nf)

    // ---- per-sample QC flags (percent), modules/sample_qc.nf -> bin/sample_qc.py (the 'reason' column names the metric and limit)
    qc_star_warn   = 70                   // WARN if STAR uniquely mapped % below this
    qc_fc_warn     = 60                   // WARN if featureCounts assigned % below this
    qc_salmon_warn = 70                   // WARN if Salmon mapped % below this
    qc_star_fail   = 50                   // FAIL (sample excluded from cohort steps) if STAR unique % below this
    qc_salmon_fail = 50                   // FAIL if Salmon mapped % below this

    // ---- independent strandedness check (modules/strand_check.nf, bin/strand_check.py): FLAG ONLY, never changes counts or QC status. Cut-offs are the nf-core/rnaseq defaults (stranded 0.8, unstranded 0.1)
    run_strand_check          = true      // false = skip the check (no rseqc environment needed)
    strand_sample_reads       = 200000    // infer_experiment.py -s: reads sampled from the BAM (the tool's own default)
    strand_stranded_min       = 0.8       // forward or reverse fraction at or above this = stranded
    strand_unstranded_max_diff = 0.1      // |forward - reverse| at or below this = unstranded

    // ---- extra RNA-QC metrics (modules/rna_qc.nf): FLAG ONLY, cohort-relative (robust z beyond cohort_outlier_mad); no published pass/fail cut-offs exist for these metrics
    run_rnaqc                 = true      // needs run_strand_check (shares its gene model) and the rseqc environment
    rnaqc_subset_transcripts  = 5000      // seeded random transcripts (>= 4 exons) for TIN
    rnaqc_genebody            = true      // gene-body coverage (3'/5' ratio); the slowest tool
    rnaqc_genebody_transcripts = 1000     // transcripts for gene-body coverage
    rnaqc_seed                = 42
    rnaqc_min_samples         = 5         // fewer samples than this: metrics are listed but not flagged

    // ---- OPT-IN fully nested internal validation (modules/nested_validation.nf): off by default (about 100-500 DESeq2 fits); report-only, never a gate
    run_nested_validation = false
    nested_repeats        = 5
    nested_permutations   = 20
    nested_outer_folds    = 5

    // ---- cohort QC pre-filter (bin/cohort_qc.R; pre-filter 1 of 2; was hard-coded 10 / min(3, n) / 3)
    cohort_min_count   = 10               // gene needs >= this many counts ...
    cohort_min_samples = 3                // ... in at least min(this, n samples) samples
    cohort_outlier_mad = 3                // flag a sample |robust z| > this (MAD) on PC1 or PC2 within its study x group cell (flag only)

    // ---- ANALYSIS input checks (bin/validate_analysis_input.py); both values PROVISIONAL, owner to confirm (design section 10)
    analysis_min_samples_per_group  = 3   // PROVISIONAL (TBD): every group needs >= this many samples that passed QC
    analysis_max_unmapped_gene_pct  = 5   // PROVISIONAL (TBD): stop if more than this % of matrix gene IDs are missing from gene_id_to_symbol.tsv

    // ---- DESeq2 (bin/deseq2.R; pre-filter 2 of 2)
    de_min_count   = 10                   // pre-filter: gene needs >= this many counts ...
    de_min_samples = 'auto'               // ... in at least this many samples; 'auto' = size of the smallest group in the sample sheet (9 for the 19 samples); a number overrides (test profile uses 2)
    de_padj        = 0.05                 // alpha: used in results(alpha=) AND as the padj cut (one value, passed to deseq2.R)
    de_lfc         = 1                    // significance: |log2FoldChange| at least this (still the UNSHRUNK value until Step 4 switches to apeglm-shrunk)
    de_volcano_labels = 15                // genes labelled in the volcano plot (was hard-coded)
    de_heatmap_genes  = 50                // genes in the top-N heatmap (was hard-coded; file name stays *_top50_heatmap.png)

    // ---- pathways (bin/ora.R, bin/gsea.R)
    path_min_gs    = 10                   // minGSSize / minSize
    path_max_gs    = 500                  // maxGSSize / maxSize
    path_q         = 0.05                 // BH q (ORA) / padj (GSEA) cutoff
    gsea_nperm     = 10000                // fgsea nPermSimple
    gsea_seed      = 42                   // set.seed for fgsea (was hard-coded)
    path_ora_plot_n  = 15                 // categories shown in an ORA dotplot (was hard-coded)
    path_gsea_plot_n = 20                 // pathways shown in the GSEA bar plot (was hard-coded)
}
