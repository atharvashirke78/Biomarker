// Input layer settings (plan results_rc1prep_19/phase1_plan_20261016/PHASE1_PLAN.md section 7.1; owner decisions section 9a).
// Read by Nextflow (included from nextflow/nextflow.config) and by scripts/input_scan.py (simple `key = value` lines only).
params {
    // ---- plots
    de_volcano_seed  = 42                                   // seed of geom_text_repel label placement in bin/deseq2.R (owner decision 9a.9)

    // ---- folder scan (--input_dir)
    fastq_extensions = '.fastq.gz,.fq.gz'                   // accepted FASTQ extensions
    fastq_mate_tags  = '_R1_001,_R2_001;_R1,_R2;.R1,.R2;_1,_2'   // mate tags tried in this order: <sample><tag><ext> (Illumina _R1_001, _R1/_R2, .R1/.R2, SRA _1/_2); one style per folder
    sample_id_regex  = '^[A-Za-z0-9][A-Za-z0-9._-]*$'             // every sample ID must match: letters, digits, . _ - only (no spaces, commas, quotes: they break file names and sample sheets); '' = no check
    metadata_file    = 'metadata.csv'                       // sits next to the FASTQ files (owner decision 9a.8)

    // ---- group labels (owner decision 9a.3): case-insensitive, exact whole-string match; every mapping used is logged; unknown label = stop
    group_aliases    = 'tumour:tumour,Tumor,tumor,T,cancer,case,disease,diseased;normal:normal,Normal,N,adjacent normal,control,healthy,ctrl'
    baseline_group   = 'normal'                             // canonical group used as the DESeq2 reference when metadata has no baseline column
}
